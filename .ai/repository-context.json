{
  "schema_ref": "schemas/repository-context.schema.json",
  "schema_version": 1,
  "project": {
    "id": "krcn-core",
    "name": "KRCN Core",
    "purpose": "Local-first context, knowledge, memory, and orchestration core",
    "architecture_owner": "Mehmet KARACAN"
  },
  "canonical": {
    "instructions": "AGENTS.md",
    "orientation": "AI-CONTEXT.md",
    "current_work": ".ai/current-work.json",
    "roadmap": "docs/plans/ROADMAP.md",
    "ownership": "config/ownership-manifest.json",
    "source_binding_schema": "schemas/source-binding.schema.json",
    "user_policy_schema": "schemas/user-policy.schema.json",
    "mutation_plan_schema": "schemas/mutation-plan.schema.json",
    "provider_request_schema": "schemas/provider-request.schema.json",
    "local_record_schema": "schemas/local-record.schema.json",
    "onboarding_plan_schema": "schemas/onboarding-plan.schema.json",
    "discovery_result_schema": "schemas/discovery-result.schema.json",
    "adapter_schema": "schemas/adapter.schema.json",
    "adapter_operation_schema": "schemas/adapter-operation.schema.json",
    "policy_layers": "docs/specifications/POLICY-LAYERS.md",
    "cli_inventory": ".ai/legacy-cli-inventory.json",
    "cli_baseline": ".ai/cli-baseline.json",
    "provider_policy": "config/provider-policy.json",
    "import_policy": "config/import-policy.json"
  },
  "bootstrap": {
    "read_order": [
      "AGENTS.md",
      "AI-CONTEXT.md",
      ".ai/current-work.json",
      ".ai/cli-baseline.json",
      "docs/plans/ROADMAP.md",
      "config/ownership-manifest.json",
      "docs/specifications/POLICY-LAYERS.md"
    ],
    "task_contract": [
      "goal",
      "scope",
      "sources",
      "constraints",
      "acceptance_criteria",
      "ownership_impact",
      "verification_evidence"
    ],
    "verification_commands": [
      "python tools/show_context.py --validate-only",
      "python tools/verify_repository.py",
      "python tools/run_tests.py",
      "python tools/krcn.py doctor"
    ]
  },
  "client_adapters": {
    "codex": {
      "entrypoint": "AGENTS.md",
      "mode": "native",
      "automatic": true
    },
    "claude-code": {
      "entrypoint": "CLAUDE.md",
      "mode": "import",
      "automatic": true
    },
    "generic-ai": {
      "entrypoint": "AI-CONTEXT.md",
      "mode": "document",
      "automatic": false
    },
    "plugin": {
      "entrypoint": ".ai/repository-context.json",
      "mode": "manifest",
      "automatic": false
    }
  },
  "data_policy": {
    "offline_by_default": true,
    "local_data_in_git": false,
    "implicit_provider_discovery": false,
    "user_data_mutation_requires_approval": true
  }
}
