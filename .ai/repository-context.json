  "bootstrap": {
    "read_order": [
      "AGENTS.md",
      "AI-CONTEXT.md",
      ".ai/current-work.json",
      ".ai/cli-baseline.json",
      "docs/plans/ROADMAP.md",
      "config/ownership-manifest.json",
      "docs/specifications/POLICY-LAYERS.md"
    ],
    "task_contract": [
      "goal",
      "scope",
      "sources",
      "constraints",
      "acceptance_criteria",
      "ownership_impact",
      "verification_evidence"
    ],
    "verification_commands": [
      "python tools/show_context.py --validate-only",
      "python tools/verify_repository.py",
      "python tools/format_json.py --check",
      "python tools/run_tests.py",
      "python tools/krcn.py doctor"
    ]
  },
  "client_adapters": {
    "codex": {
      "entrypoint": "AGENTS.md",
      "mode": "native",
      "automatic": true
    },
    "claude-code": {
      "entrypoint": "CLAUDE.md",
      "mode": "import",
      "automatic": true
    },
    "generic-ai": {
      "entrypoint": "AI-CONTEXT.md",
      "mode": "document",
      "automatic": false
    },
    "plugin": {
      "entrypoint": ".ai/repository-context.json",
      "mode": "manifest",
      "automatic": false
    },
    "sdk": {
      "entrypoint": "src/krcn_core/application.py",
      "mode": "native",
      "automatic": false
    },
    "mcp": {
      "entrypoint": "src/krcn_core/application.py",
      "mode": "native",
      "automatic": false
    }
  },
  "data_policy": {
    "offline_by_default": true,
    "local_data_in_git": false,
    "implicit_provider_discovery": false,
    "user_data_mutation_requires_approval": true
  }
}
