{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:unified-retrieval-query:1",
  "title": "KRCN Core unified retrieval query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "query_id",
    "text",
    "project_ids",
    "scope",
    "intent",
    "result_limit",
    "token_budget"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/unified-retrieval-query.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "query_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "project_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "scope": {
      "enum": [
        "project",
        "multi-project"
      ]
    },
    "intent": {
      "enum": [
        "auto",
        "status",
        "code",
        "oracle",
        "knowledge",
        "broad"
      ]
    },
    "result_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "token_budget": {
      "type": "integer",
      "minimum": 256,
      "maximum": 32000
    }
  }
}
