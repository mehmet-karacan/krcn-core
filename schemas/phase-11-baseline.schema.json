{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:phase-11-baseline:1",
  "title": "KRCN Core completed Phase 11 baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "baseline_id",
    "phase_id",
    "status",
    "completed_steps",
    "capabilities",
    "safe_operations",
    "guarantees",
    "verification",
    "maintenance"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/phase-11-baseline.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "baseline_id": {
      "const": "phase-11-project-capsule-layout-v2"
    },
    "phase_id": {
      "const": "phase-11"
    },
    "status": {
      "const": "ready"
    },
    "completed_steps": {
      "const": 9
    },
    "capabilities": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "safe_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "guarantees": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": {
        "const": "passed"
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "layout_version",
        "portable_modes",
        "rebind_required_after_import"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "layout_version": {
          "const": 2
        },
        "portable_modes": {
          "const": [
            "thin",
            "ready"
          ]
        },
        "rebind_required_after_import": {
          "const": true
        }
      }
    }
  }
}
