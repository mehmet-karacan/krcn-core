{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:retrieval-golden-set:1",
  "title": "KRCN retrieval golden set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "suite_id",
    "revision",
    "top_k",
    "thresholds",
    "cases",
    "suite_digest",
    "invariants"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/retrieval-golden-set.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_recall_at_k_basis_points",
        "minimum_mrr_basis_points",
        "minimum_ndcg_at_k_basis_points",
        "minimum_exact_top_one_basis_points",
        "maximum_p95_latency_ms"
      ],
      "properties": {
        "minimum_recall_at_k_basis_points": {
          "$ref": "#/$defs/basisPoints"
        },
        "minimum_mrr_basis_points": {
          "$ref": "#/$defs/basisPoints"
        },
        "minimum_ndcg_at_k_basis_points": {
          "$ref": "#/$defs/basisPoints"
        },
        "minimum_exact_top_one_basis_points": {
          "$ref": "#/$defs/basisPoints"
        },
        "maximum_p95_latency_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "suite_digest": {
      "$ref": "#/$defs/sha256"
    },
    "invariants": {
      "const": {
        "source_content_included": false,
        "secret_values_included": false,
        "physical_paths_included": false,
        "provider_call_performed": false,
        "grants_authority": false
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "basisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "reference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "category",
        "language",
        "query_text",
        "scope_project_ids",
        "expected_relevant_refs",
        "forbidden_refs",
        "expected_outcome",
        "critical"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": [
            "exact-id",
            "typo-lexical",
            "business-concept",
            "symbol-lookup",
            "dependency-impact",
            "continuity-resume",
            "plsql-symbol",
            "cross-project-isolation",
            "stale-revision"
          ]
        },
        "language": {
          "enum": [
            "tr",
            "en",
            "polyglot"
          ]
        },
        "query_text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "scope_project_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "expected_relevant_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "forbidden_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "expected_outcome": {
          "enum": [
            "ranked",
            "empty",
            "stale-rejected"
          ]
        },
        "critical": {
          "type": "boolean"
        }
      }
    }
  }
}
