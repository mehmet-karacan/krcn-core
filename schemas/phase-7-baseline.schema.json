        "doctor": {
          "const": "passed"
        },
        "offline_install": {
          "const": "passed"
        },
        "directory_only": {
          "const": "passed"
        },
        "natural_language": {
          "const": "passed"
        },
        "metadata_inference": {
          "const": "passed"
        },
        "source_no_copy": {
          "const": "passed"
        },
        "policy_preservation": {
          "const": "passed"
        },
        "duplicate_prevention": {
          "const": "passed"
        },
        "client_parity": {
          "const": "passed"
        }
      }
