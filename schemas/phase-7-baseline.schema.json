{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:phase-7-baseline:1",
  "title": "KRCN Core completed Phase 7 baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
