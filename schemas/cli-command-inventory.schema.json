{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:cli-command-inventory:1",
  "title": "KRCN Core legacy CLI command inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "baseline_id",
    "status",
    "source_code_imported",
    "global_findings",
    "commands"
  ],
  "properties": {
    "schema_ref": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "baseline_id": { "type": "string", "minLength": 1 },
    "status": { "const": "reference-only" },
    "source_code_imported": { "const": false },
    "global_findings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "visibility",
          "behavior",
          "reads",
          "writes",
          "network_effects",
          "risk_codes",
          "disposition"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "command": { "type": "string", "minLength": 1 },
          "visibility": { "enum": ["public", "internal"] },
          "behavior": { "enum": ["read", "write", "mixed"] },
          "reads": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/ownershipClass" }
          },
          "writes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/ownershipClass" }
          },
          "network_effects": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "risk_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "disposition": { "enum": ["preserve", "redesign", "defer", "internal-only"] }
        }
      }
    }
  },
  "$defs": {
    "ownershipClass": {
      "enum": ["core", "runtime", "user-data", "derived", "secrets", "unmanaged", "external"]
    }
  }
}
