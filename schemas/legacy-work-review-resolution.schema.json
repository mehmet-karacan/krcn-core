{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:legacy-work-review-resolution:1",
  "title": "KRCN Core legacy work review resolution summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "project_id",
    "decision",
    "resolved_identity_count",
    "splits",
    "unresolved_review_count",
    "import_ready",
    "paths_disclosed"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/legacy-work-review-resolution.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "decision": {
      "const": "split-conflicts"
    },
    "resolved_identity_count": {
      "type": "integer",
      "minimum": 0
    },
    "splits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_id",
          "variant_count",
          "work_item_ids"
        ],
        "properties": {
          "external_id": {
            "type": "string",
            "minLength": 1
          },
          "variant_count": {
            "type": "integer",
            "minimum": 1
          },
          "work_item_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      }
    },
    "unresolved_review_count": {
      "type": "integer",
      "minimum": 0
    },
    "import_ready": {
      "type": "boolean"
    },
    "paths_disclosed": {
      "const": false
    }
  }
}
