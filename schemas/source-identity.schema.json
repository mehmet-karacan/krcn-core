{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:source-identity:1",
  "title": "KRCN Core external source identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "binding_id",
    "algorithm",
    "digest",
    "file_count"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "binding_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "algorithm": { "const": "krcn-discovery-tree-sha256-v1" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file_count": { "type": "integer", "minimum": 0 }
  }
}
