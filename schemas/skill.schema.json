{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:skill:1",
  "title": "KRCN Core skill definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "name",
    "description",
    "role",
    "output_schema",
    "may_write_sources",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "skill_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "role": { "enum": ["explorer", "worker", "verifier"] },
    "input_schema": { "type": "string" },
    "output_schema": { "type": "string", "minLength": 1 },
    "may_write_sources": { "type": "boolean", "default": false },
    "source_write_conditions": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["draft", "pending-approval", "active", "retired"] }
  }
}
