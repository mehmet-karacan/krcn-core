{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:project-home-manifest:1",
  "title": "KRCN Core project-home manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "layout_version",
    "home_id",
    "home_kind",
    "project_scoped",
    "source_copy",
    "local_data_in_git"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/project-home-manifest.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "layout_version": {
      "const": 2
    },
    "home_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "home_kind": {
      "const": "project"
    },
    "project_scoped": {
      "const": true
    },
    "source_copy": {
      "const": false
    },
    "local_data_in_git": {
      "const": false
    }
  }
}
