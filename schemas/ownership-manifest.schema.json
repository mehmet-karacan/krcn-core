{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krcn.dev/schemas/ownership-manifest.schema.json",
  "title": "KRCN Core ownership manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_unmatched",
    "classes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_unmatched": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "merge_strategy",
        "approval_required"
      ],
      "properties": {
        "ownership": {
          "const": "unmanaged"
        },
        "merge_strategy": {
          "const": "preserve"
        },
        "approval_required": {
          "const": true
        }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "merge_strategy",
          "paths"
        ],
        "properties": {
          "id": {
            "enum": [
              "core",
              "runtime",
              "user-data",
              "derived",
              "secrets",
              "unmanaged"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "merge_strategy": {
            "enum": [
              "replace-managed",
              "preserve",
              "migrate-or-rebuild"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
