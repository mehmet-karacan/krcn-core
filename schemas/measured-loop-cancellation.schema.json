{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:measured-loop-cancellation:1",
  "title": "KRCN Core durable measured loop cancellation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "run_id",
    "plan_digest",
    "requested_at",
    "requester_digest",
    "reason_code",
    "record_only",
    "process_signal_sent",
    "process_termination_claimed",
    "grants_authority",
    "cancellation_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/measured-loop-cancellation.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "requester_digest": {
      "$ref": "#/$defs/digest"
    },
    "reason_code": {
      "$ref": "#/$defs/id"
    },
    "record_only": {
      "const": true
    },
    "process_signal_sent": {
      "const": false
    },
    "process_termination_claimed": {
      "const": false
    },
    "grants_authority": {
      "const": false
    },
    "cancellation_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
