{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:local-record:1",
  "title": "KRCN Core local record envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "revision",
    "payload",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "enum": ["workspaces", "projects", "source-bindings", "integrations", "source-states", "authoritative-sources", "knowledge"] },
    "record_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "payload": { "type": "object" },
    "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
