{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:effect-claim:1",
  "title": "KRCN immutable effect claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "claim_id",
    "bindings",
    "effect",
    "validation_gate_id",
    "runtime",
    "safety",
    "claim_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/effect-claim.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "claim_id": {
      "$ref": "#/$defs/digest"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "work_item_id",
        "task_id",
        "task_plan_id",
        "step_id",
        "queue_id",
        "attempt_id",
        "attempt_number",
        "execution_identity_id",
        "lease_id",
        "fencing_token"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "work_item_id": {
          "$ref": "#/$defs/id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "task_plan_id": {
          "$ref": "#/$defs/digest"
        },
        "step_id": {
          "$ref": "#/$defs/id"
        },
        "queue_id": {
          "$ref": "#/$defs/id"
        },
        "attempt_id": {
          "$ref": "#/$defs/id"
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1
        },
        "execution_identity_id": {
          "$ref": "#/$defs/digest"
        },
        "lease_id": {
          "$ref": "#/$defs/id"
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "effect_type",
        "effect_digest",
        "idempotency_key",
        "effect_authorization_id",
        "mutation_plan_id",
        "provider_request_id"
      ],
      "properties": {
        "effect_id": {
          "$ref": "#/$defs/id"
        },
        "effect_type": {
          "enum": [
            "write",
            "execute",
            "network"
          ]
        },
        "effect_digest": {
          "$ref": "#/$defs/digest"
        },
        "idempotency_key": {
          "$ref": "#/$defs/digest"
        },
        "effect_authorization_id": {
          "$ref": "#/$defs/digest"
        },
        "mutation_plan_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "validation_gate_id": {
      "$ref": "#/$defs/digest"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_digest",
        "claimed_at"
      ],
      "properties": {
        "host_digest": {
          "$ref": "#/$defs/digest"
        },
        "claimed_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants_authority",
        "effect_performed",
        "contains_raw_payload",
        "contains_physical_paths",
        "contains_credentials"
      ],
      "properties": {
        "grants_authority": {
          "const": false
        },
        "effect_performed": {
          "const": false
        },
        "contains_raw_payload": {
          "const": false
        },
        "contains_physical_paths": {
          "const": false
        },
        "contains_credentials": {
          "const": false
        }
      }
    },
    "claim_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
