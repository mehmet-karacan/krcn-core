{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:model-benchmark-execution-receipt:1",
  "title": "KRCN durable model benchmark execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "receipt_id",
    "claim_id",
    "claim_digest",
    "plan_digest",
    "execution_host_digest",
    "aggregate_digest",
    "output_digest",
    "failure_category",
    "failure_digest",
    "receipt_request_digest",
    "status",
    "receipt_digest",
    "grants_authority"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/model-benchmark-execution-receipt.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "receipt_id": {
      "$ref": "#/$defs/id"
    },
    "claim_id": {
      "$ref": "#/$defs/id"
    },
    "claim_digest": {
      "$ref": "#/$defs/digest"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_host_digest": {
      "$ref": "#/$defs/digest"
    },
    "aggregate_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "output_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_category": {
      "oneOf": [
        {
          "enum": [
            "outcome-validation-failed",
            "runner-validation-failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_request_digest": {
      "$ref": "#/$defs/digest"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "grants_authority": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "aggregate_digest": {
            "$ref": "#/$defs/digest"
          },
          "output_digest": {
            "$ref": "#/$defs/digest"
          },
          "failure_category": {
            "type": "null"
          },
          "failure_digest": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "aggregate_digest": {
            "type": "null"
          },
          "output_digest": {
            "type": "null"
          },
          "failure_category": {
            "enum": [
              "outcome-validation-failed",
              "runner-validation-failed"
            ]
          },
          "failure_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
