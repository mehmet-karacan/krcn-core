{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:model-decision:1",
  "title": "KRCN closed-loop model assignment decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "decision_id",
    "project_id",
    "client_id",
    "workload",
    "routing_workload",
    "role",
    "selected_candidate_ref",
    "selected_model_ref",
    "selected_model_id",
    "model_assignment_id",
    "selection_basis",
    "score_basis_points",
    "estimated_latency_ms",
    "estimated_cost_microunits",
    "fallbacks",
    "excluded_candidates",
    "evidence_digests",
    "policy_digest",
    "routing_policy_digest",
    "price_catalog_digest",
    "decision_digest",
    "provider_call_performed",
    "grants_authority"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/model-decision.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "decision_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "client_id": {
      "$ref": "#/$defs/id"
    },
    "workload": {
      "$ref": "#/$defs/id"
    },
    "routing_workload": {
      "$ref": "#/$defs/id"
    },
    "role": {
      "enum": [
        "planner",
        "worker",
        "verifier"
      ]
    },
    "selected_candidate_ref": {
      "$ref": "#/$defs/id"
    },
    "selected_model_ref": {
      "$ref": "#/$defs/nullableId"
    },
    "selected_model_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "model_assignment_id": {
      "$ref": "#/$defs/id"
    },
    "selection_basis": {
      "enum": [
        "qualified-net-value",
        "client-default-fallback",
        "offline-fallback"
      ]
    },
    "score_basis_points": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "estimated_latency_ms": {
      "$ref": "#/$defs/nullableNonnegative"
    },
    "estimated_cost_microunits": {
      "$ref": "#/$defs/nullableNonnegative"
    },
    "fallbacks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_ref",
          "model_ref",
          "model_id",
          "score_basis_points"
        ],
        "properties": {
          "candidate_ref": {
            "$ref": "#/$defs/id"
          },
          "model_ref": {
            "$ref": "#/$defs/nullableId"
          },
          "model_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "score_basis_points": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "excluded_candidates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_ref",
          "reason_codes"
        ],
        "properties": {
          "candidate_ref": {
            "$ref": "#/$defs/id"
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "evidence_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "routing_policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "price_catalog_digest": {
      "$ref": "#/$defs/nullableDigest"
    },
    "decision_digest": {
      "$ref": "#/$defs/digest"
    },
    "provider_call_performed": {
      "const": false
    },
    "grants_authority": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "nullableId": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableNonnegative": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
