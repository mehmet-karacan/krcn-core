{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:measured-loop-morning-digest:1",
  "title": "KRCN Core safe measured loop morning digest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "run_id",
    "project_id",
    "work_item_id",
    "state",
    "stop_reason",
    "generated_at",
    "status_digest",
    "latest_iteration_digest",
    "rounds",
    "usage",
    "metrics",
    "next_safe_action",
    "verifier_execution_identity_id",
    "grants_authority",
    "contains_prompts",
    "contains_outputs",
    "contains_physical_paths",
    "contains_secrets",
    "morning_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/measured-loop-morning-digest.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "state": {
      "enum": [
        "cancelled",
        "completed",
        "planned",
        "recovery-required",
        "running",
        "stopped"
      ]
    },
    "stop_reason": {
      "enum": [
        "accept",
        "budget",
        "cancel",
        "continue",
        "plateau",
        "revert",
        "zombie"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status_digest": {
      "$ref": "#/$defs/digest"
    },
    "latest_iteration_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "rounds": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "next_safe_action": {
      "$ref": "#/$defs/id"
    },
    "verifier_execution_identity_id": {
      "$ref": "#/$defs/digest"
    },
    "grants_authority": {
      "const": false
    },
    "contains_prompts": {
      "const": false
    },
    "contains_outputs": {
      "const": false
    },
    "contains_physical_paths": {
      "const": false
    },
    "contains_secrets": {
      "const": false
    },
    "morning_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_microunits",
        "attempts",
        "peak_concurrency"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "peak_concurrency": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "value",
        "target",
        "target_met"
      ],
      "properties": {
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "type": "integer"
        },
        "target": {
          "type": "integer"
        },
        "target_met": {
          "type": "boolean"
        }
      }
    }
  }
}
