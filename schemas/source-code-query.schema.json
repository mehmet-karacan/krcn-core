{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:source-code-query:1",
  "title": "KRCN Core source code query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "query_id",
    "project_id",
    "text",
    "languages",
    "path_prefix",
    "include_content",
    "limit"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/source-code-query.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "query_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "path_prefix": {
      "type": [
        "string",
        "null"
      ]
    },
    "include_content": {
      "type": "boolean"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}
