    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_order",
        "task_contract",
        "verification_commands"
      ],
      "properties": {
        "read_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "task_contract": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "goal",
              "scope",
              "sources",
              "constraints",
              "acceptance_criteria",
              "ownership_impact",
              "verification_evidence"
            ]
          }
        },
        "verification_commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "client_adapters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/clientAdapter"
      },
      "required": [
        "codex",
        "claude-code",
        "generic-ai",
        "plugin",
        "sdk",
        "mcp"
      ]
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_by_default",
        "local_data_in_git",
        "operational_artifacts_in_core",
        "project_operational_artifact_root",
        "global_operational_artifact_root",
        "implicit_provider_discovery",
        "user_data_mutation_requires_approval"
      ],
      "properties": {
        "offline_by_default": {
          "const": true
        },
        "local_data_in_git": {
          "const": false
        },
        "operational_artifacts_in_core": {
          "const": false
        },
        "project_operational_artifact_root": {
          "const": ".krcn/projects/<project-id>/local-data/client-artifacts"
        },
        "global_operational_artifact_root": {
          "const": ".krcn/global/local-data/client-artifacts"
        },
        "implicit_provider_discovery": {
          "const": false
        },
        "user_data_mutation_requires_approval": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "clientAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "mode"
      ],
      "properties": {
        "entrypoint": {
          "$ref": "#/$defs/repoPath"
        },
        "mode": {
          "enum": [
            "native",
            "import",
            "document",
            "manifest"
          ]
        },
        "automatic": {
          "type": "boolean"
        }
      }
    }
  }
}
