{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:repository-context:1",
  "title": "KRCN Core repository context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "project",
    "canonical",
    "bootstrap",
    "client_adapters",
    "data_policy"
  ],
  "properties": {
    "schema_ref": { "$ref": "#/$defs/repoPath" },
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "architecture_owner"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "architecture_owner": { "type": "string", "minLength": 1 }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions",
        "orientation",
        "current_work",
        "roadmap",
        "ownership",
        "source_binding_schema",
        "user_policy_schema",
        "mutation_plan_schema",
        "provider_request_schema",
        "local_record_schema",
        "onboarding_plan_schema",
        "discovery_result_schema",
        "adapter_schema",
        "adapter_operation_schema",
        "integration_schema",
        "source_state_schema",
        "rescan_plan_schema",
        "application_request_schema",
        "application_response_schema",
        "phase_baseline_schema",
        "phase_two_baseline",
        "phase_three_baseline",
        "phase_three_merge_boundary",
        "phase_four_boundary",
        "phase_four_baseline",
        "phase_five_boundary",
        "phase_five_baseline",
        "project_local_home_boundary",
        "orchestration_boundary",
        "orchestration_boundary_schema",
        "task_intent_schema",
        "capability_registry",
        "capability_registry_schema",
        "task_plan_schema",
        "task_authorization_schema",
        "worker_execution_schema",
        "task_verification_schema",
        "orchestration_state_schema",
        "orchestration_event_schema",
        "orchestration_checkpoint_schema",
        "orchestration_handoff_schema",
        "information_classes",
        "information_classes_schema",
        "information_record_schema",
        "information_catalog_schema",
        "exact_retrieval_query_schema",
        "exact_retrieval_result_schema",
        "information_relation_schema",
        "dependency_query_schema",
        "dependency_result_schema",
        "semantic_query_schema",
        "semantic_result_schema",
        "context_build_request_schema",
        "context_package_v2_schema",
        "memory_candidate_schema",
        "memory_review_schema",
        "memory_action_schema",
        "policy_promotion_plan_schema",
        "release_manifest_schema",
        "installation_state_schema",
        "installation_inspection_schema",
        "release_trust",
        "release_diff_schema",
        "merge_plan_schema",
        "backup_manifest_schema",
        "deployment_journal_schema",
        "migration_execution",
        "policy_layers",
        "cli_inventory",
        "cli_baseline",
        "provider_policy",
        "import_policy"
      ],
      "properties": {
        "instructions": { "$ref": "#/$defs/repoPath" },
        "orientation": { "$ref": "#/$defs/repoPath" },
        "current_work": { "$ref": "#/$defs/repoPath" },
        "roadmap": { "$ref": "#/$defs/repoPath" },
        "ownership": { "$ref": "#/$defs/repoPath" },
        "source_binding_schema": { "$ref": "#/$defs/repoPath" },
        "user_policy_schema": { "$ref": "#/$defs/repoPath" },
        "mutation_plan_schema": { "$ref": "#/$defs/repoPath" },
        "provider_request_schema": { "$ref": "#/$defs/repoPath" },
        "local_record_schema": { "$ref": "#/$defs/repoPath" },
        "onboarding_plan_schema": { "$ref": "#/$defs/repoPath" },
        "discovery_result_schema": { "$ref": "#/$defs/repoPath" },
        "adapter_schema": { "$ref": "#/$defs/repoPath" },
        "adapter_operation_schema": { "$ref": "#/$defs/repoPath" },
        "integration_schema": { "$ref": "#/$defs/repoPath" },
        "source_state_schema": { "$ref": "#/$defs/repoPath" },
        "rescan_plan_schema": { "$ref": "#/$defs/repoPath" },
        "application_request_schema": { "$ref": "#/$defs/repoPath" },
        "application_response_schema": { "$ref": "#/$defs/repoPath" },
        "phase_baseline_schema": { "$ref": "#/$defs/repoPath" },
        "phase_two_baseline": { "$ref": "#/$defs/repoPath" },
        "phase_three_baseline": { "$ref": "#/$defs/repoPath" },
        "phase_three_merge_boundary": { "$ref": "#/$defs/repoPath" },
        "phase_four_boundary": { "$ref": "#/$defs/repoPath" },
        "phase_four_baseline": { "$ref": "#/$defs/repoPath" },
        "phase_five_boundary": { "$ref": "#/$defs/repoPath" },
        "phase_five_baseline": { "$ref": "#/$defs/repoPath" },
        "project_local_home_boundary": { "$ref": "#/$defs/repoPath" },
        "orchestration_boundary": { "$ref": "#/$defs/repoPath" },
        "orchestration_boundary_schema": { "$ref": "#/$defs/repoPath" },
        "task_intent_schema": { "$ref": "#/$defs/repoPath" },
        "capability_registry": { "$ref": "#/$defs/repoPath" },
        "capability_registry_schema": { "$ref": "#/$defs/repoPath" },
        "task_plan_schema": { "$ref": "#/$defs/repoPath" },
        "task_authorization_schema": { "$ref": "#/$defs/repoPath" },
        "worker_execution_schema": { "$ref": "#/$defs/repoPath" },
        "task_verification_schema": { "$ref": "#/$defs/repoPath" },
        "orchestration_state_schema": { "$ref": "#/$defs/repoPath" },
        "orchestration_event_schema": { "$ref": "#/$defs/repoPath" },
        "orchestration_checkpoint_schema": { "$ref": "#/$defs/repoPath" },
        "orchestration_handoff_schema": { "$ref": "#/$defs/repoPath" },
        "information_classes": { "$ref": "#/$defs/repoPath" },
        "information_classes_schema": { "$ref": "#/$defs/repoPath" },
        "information_record_schema": { "$ref": "#/$defs/repoPath" },
        "information_catalog_schema": { "$ref": "#/$defs/repoPath" },
        "exact_retrieval_query_schema": { "$ref": "#/$defs/repoPath" },
        "exact_retrieval_result_schema": { "$ref": "#/$defs/repoPath" },
        "information_relation_schema": { "$ref": "#/$defs/repoPath" },
        "dependency_query_schema": { "$ref": "#/$defs/repoPath" },
        "dependency_result_schema": { "$ref": "#/$defs/repoPath" },
        "semantic_query_schema": { "$ref": "#/$defs/repoPath" },
        "semantic_result_schema": { "$ref": "#/$defs/repoPath" },
        "context_build_request_schema": { "$ref": "#/$defs/repoPath" },
        "context_package_v2_schema": { "$ref": "#/$defs/repoPath" },
        "memory_candidate_schema": { "$ref": "#/$defs/repoPath" },
        "memory_review_schema": { "$ref": "#/$defs/repoPath" },
        "memory_action_schema": { "$ref": "#/$defs/repoPath" },
        "policy_promotion_plan_schema": { "$ref": "#/$defs/repoPath" },
        "release_manifest_schema": { "$ref": "#/$defs/repoPath" },
        "installation_state_schema": { "$ref": "#/$defs/repoPath" },
        "installation_inspection_schema": { "$ref": "#/$defs/repoPath" },
        "release_trust": { "$ref": "#/$defs/repoPath" },
        "release_diff_schema": { "$ref": "#/$defs/repoPath" },
        "merge_plan_schema": { "$ref": "#/$defs/repoPath" },
        "backup_manifest_schema": { "$ref": "#/$defs/repoPath" },
        "deployment_journal_schema": { "$ref": "#/$defs/repoPath" },
        "migration_execution": { "$ref": "#/$defs/repoPath" },
        "policy_layers": { "$ref": "#/$defs/repoPath" },
        "cli_inventory": { "$ref": "#/$defs/repoPath" },
        "cli_baseline": { "$ref": "#/$defs/repoPath" },
        "provider_policy": { "$ref": "#/$defs/repoPath" },
        "import_policy": { "$ref": "#/$defs/repoPath" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_order", "task_contract", "verification_commands"],
      "properties": {
        "read_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "task_contract": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "goal",
              "scope",
              "sources",
              "constraints",
              "acceptance_criteria",
              "ownership_impact",
              "verification_evidence"
            ]
          }
        },
        "verification_commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "client_adapters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/clientAdapter" },
      "required": ["codex", "claude-code", "generic-ai", "plugin", "sdk", "mcp"]
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_by_default",
        "local_data_in_git",
        "implicit_provider_discovery",
        "user_data_mutation_requires_approval"
      ],
      "properties": {
        "offline_by_default": { "const": true },
        "local_data_in_git": { "const": false },
        "implicit_provider_discovery": { "const": false },
        "user_data_mutation_requires_approval": { "const": true }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "clientAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "mode"],
      "properties": {
        "entrypoint": { "$ref": "#/$defs/repoPath" },
        "mode": { "enum": ["native", "import", "document", "manifest"] },
        "automatic": { "type": "boolean" }
      }
    }
  }
}
