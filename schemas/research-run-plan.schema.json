{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:research-run-plan:1",
  "title": "KRCN Core research run exact plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "plan_id",
    "research_id",
    "scope",
    "project_id",
    "roles",
    "prompt_count",
    "effect_plans",
    "no_op",
    "operator_mediated",
    "provider_calls_planned",
    "gemini_required",
    "optional_provider_statuses",
    "vector_index_planned",
    "source_paths_persisted"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/research-run-plan.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "$ref": "#/$defs/digest"
    },
    "research_id": {
      "$ref": "#/$defs/id"
    },
    "scope": {
      "enum": [
        "project",
        "global"
      ]
    },
    "project_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "roles": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "prompt_count": {
      "const": 5
    },
    "effect_plans": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "no_op": {
      "type": "boolean"
    },
    "operator_mediated": {
      "const": true
    },
    "provider_calls_planned": {
      "const": 0
    },
    "gemini_required": {
      "const": false
    },
    "optional_provider_statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gemini"
      ],
      "properties": {
        "gemini": {
          "const": "optional-provider-unavailable"
        }
      }
    },
    "vector_index_planned": {
      "const": false
    },
    "source_paths_persisted": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
