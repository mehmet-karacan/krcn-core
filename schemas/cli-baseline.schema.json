{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:cli-baseline:1",
  "title": "KRCN Core sanitized CLI baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "baseline_id",
    "status",
    "legacy_source_imported",
    "entrypoint",
    "safe_commands",
    "compatibility_catalog_count",
    "safety_gates",
    "verification"
  ],
  "properties": {
    "schema_ref": { "const": "schemas/cli-baseline.schema.json" },
    "schema_version": { "const": 1 },
    "baseline_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "status": { "const": "ready" },
    "legacy_source_imported": { "const": false },
    "entrypoint": { "const": "krcn_core.cli.app:main" },
    "safe_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "compatibility_catalog_count": { "const": 29 },
    "safety_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "source-binding",
          "user-policy",
          "database-statement",
          "mutation",
          "provider"
        ]
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hermetic_tests", "doctor", "offline_install"],
      "properties": {
        "hermetic_tests": { "const": "passed" },
        "doctor": { "const": "passed" },
        "offline_install": { "const": "passed" }
      }
    }
  }
}
