{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:user-policy:1",
  "title": "KRCN Core user policy record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "scope",
    "revision",
    "rules"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["global", "project", "source", "integration"] },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "resource_type",
          "operations",
          "effect",
          "provenance",
          "active"
        ],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "resource_type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "effect": { "enum": ["allow", "deny", "require-approval"] },
          "constraints": { "type": "object", "additionalProperties": true },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": ["explicit-user", "approved-memory", "approved-import"]
              },
              "evidence_ref": { "type": "string", "minLength": 1 }
            }
          },
          "active": { "type": "boolean" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
