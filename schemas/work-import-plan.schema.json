{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:work-import-plan:1",
  "title": "KRCN Core exact legacy work import plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "plan_id",
    "project_id",
    "import_id",
    "import_digest",
    "source_inventory",
    "graph_digest_before",
    "graph_digest_after",
    "no_op",
    "item_count",
    "work_item_ids",
    "effect_plans",
    "paths_disclosed"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/work-import-plan.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "$ref": "#/$defs/digest"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "import_id": {
      "$ref": "#/$defs/id"
    },
    "import_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "logical_root",
        "entry_count",
        "inventory_digest",
        "paths_disclosed"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "logical_root": {
          "type": "string",
          "minLength": 1
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_digest": {
          "$ref": "#/$defs/digest"
        },
        "paths_disclosed": {
          "const": false
        }
      }
    },
    "graph_digest_before": {
      "$ref": "#/$defs/digest"
    },
    "graph_digest_after": {
      "$ref": "#/$defs/digest"
    },
    "no_op": {
      "type": "boolean"
    },
    "item_count": {
      "type": "integer",
      "minimum": 1
    },
    "work_item_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "effect_plans": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "paths_disclosed": {
      "const": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
