{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:model-capability-preservation-policy:1",
  "title": "KRCN Core model capability preservation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "revision",
    "thresholds",
    "hard_constraints",
    "soft_guidance",
    "context_policy",
    "invariants"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/model-capability-preservation-policy.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_general_success_regression_basis_points",
        "maximum_general_score_regression_basis_points",
        "maximum_critical_regressions",
        "maximum_hard_constraint_violations",
        "advisory_token_overhead_basis_points",
        "advisory_latency_overhead_basis_points",
        "advisory_agent_call_overhead_basis_points",
        "advisory_human_intervention_overhead_basis_points"
      ],
      "properties": {
        "maximum_general_success_regression_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maximum_general_score_regression_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maximum_critical_regressions": {
          "const": 0
        },
        "maximum_hard_constraint_violations": {
          "const": 0
        },
        "advisory_token_overhead_basis_points": {
          "type": "integer",
          "minimum": 0
        },
        "advisory_latency_overhead_basis_points": {
          "type": "integer",
          "minimum": 0
        },
        "advisory_agent_call_overhead_basis_points": {
          "type": "integer",
          "minimum": 0
        },
        "advisory_human_intervention_overhead_basis_points": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hard_constraints": {
      "$ref": "#/$defs/identifierList"
    },
    "soft_guidance": {
      "$ref": "#/$defs/identifierList"
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_required_context",
        "lazy_retrieval",
        "full_history_by_default",
        "private_chain_of_thought_persisted",
        "alternative_and_counter_evidence_allowed",
        "assumption_challenge_allowed"
      ],
      "properties": {
        "minimum_required_context": {
          "const": true
        },
        "lazy_retrieval": {
          "const": true
        },
        "full_history_by_default": {
          "const": false
        },
        "private_chain_of_thought_persisted": {
          "const": false
        },
        "alternative_and_counter_evidence_allowed": {
          "const": true
        },
        "assumption_challenge_allowed": {
          "const": true
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_call_during_evaluation",
        "raw_prompt_persisted",
        "raw_output_persisted",
        "model_decision_grants_authority"
      ],
      "properties": {
        "provider_call_during_evaluation": {
          "const": false
        },
        "raw_prompt_persisted": {
          "const": false
        },
        "raw_output_persisted": {
          "const": false
        },
        "model_decision_grants_authority": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "identifierList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    }
  }
}
