{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:model-benchmark-trial-result:1",
  "title": "KRCN sanitized model benchmark trial result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "plan_digest",
    "trial_id",
    "repetition",
    "execution_profile_digest",
    "project_id",
    "suite_digest",
    "source_digest",
    "workload_id",
    "workload_digest",
    "case_digest",
    "model_ref",
    "inventory_digest",
    "observed_at",
    "quality_score_basis_points",
    "reliability_score_basis_points",
    "latency_ms",
    "input_tokens",
    "output_tokens",
    "retry_count",
    "human_corrections",
    "estimated_cost_microunits",
    "actual_cost_microunits",
    "timed_out",
    "parse_passed",
    "format_passed",
    "evidence_passed",
    "verifier_passed",
    "failure_category",
    "verifier_execution_ref",
    "verifier_model_family",
    "trial_digest",
    "invariants"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/model-benchmark-trial-result.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "trial_id": {
      "$ref": "#/$defs/id"
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "execution_profile_digest": {
      "$ref": "#/$defs/digest"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "suite_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_digest": {
      "$ref": "#/$defs/digest"
    },
    "workload_id": {
      "$ref": "#/$defs/id"
    },
    "workload_digest": {
      "$ref": "#/$defs/digest"
    },
    "case_digest": {
      "$ref": "#/$defs/digest"
    },
    "model_ref": {
      "$ref": "#/$defs/id"
    },
    "inventory_digest": {
      "$ref": "#/$defs/digest"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality_score_basis_points": {
      "$ref": "#/$defs/basisPoints"
    },
    "reliability_score_basis_points": {
      "$ref": "#/$defs/basisPoints"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    },
    "input_tokens": {
      "$ref": "#/$defs/nonnegative"
    },
    "output_tokens": {
      "$ref": "#/$defs/nonnegative"
    },
    "retry_count": {
      "$ref": "#/$defs/nonnegative"
    },
    "human_corrections": {
      "$ref": "#/$defs/nonnegative"
    },
    "estimated_cost_microunits": {
      "$ref": "#/$defs/nonnegative"
    },
    "actual_cost_microunits": {
      "$ref": "#/$defs/nonnegative"
    },
    "timed_out": {
      "type": "boolean"
    },
    "parse_passed": {
      "type": "boolean"
    },
    "format_passed": {
      "type": "boolean"
    },
    "evidence_passed": {
      "type": "boolean"
    },
    "verifier_passed": {
      "type": "boolean"
    },
    "failure_category": {
      "oneOf": [
        {
          "enum": [
            "adapter-error",
            "evidence-failed",
            "format-failed",
            "parse-failed",
            "timeout",
            "verifier-failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "verifier_execution_ref": {
      "$ref": "#/$defs/id"
    },
    "verifier_model_family": {
      "$ref": "#/$defs/id"
    },
    "trial_digest": {
      "$ref": "#/$defs/digest"
    },
    "invariants": {
      "$ref": "#/$defs/invariants"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    },
    "basisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "invariants": {
      "const": {
        "prompt_content_included": false,
        "response_content_included": false,
        "source_content_included": false,
        "credential_values_included": false,
        "physical_paths_included": false,
        "grants_authority": false
      }
    }
  }
}
