{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:implementation-result:1",
  "title": "KRCN implementation delivery result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_ref", "schema_version", "result_id", "plan_id", "project_id", "work_item_id", "task_plan_id", "patch_digest", "changed_paths", "test_results", "status", "rollback_available", "commit_created", "push_performed", "completion_allowed", "authority_granted", "result_digest"],
  "properties": {
    "schema_ref": {"const": "schemas/implementation-result.schema.json"}, "schema_version": {"const": 1},
    "result_id": {"$ref": "#/$defs/digest"}, "plan_id": {"$ref": "#/$defs/digest"}, "project_id": {"type": "string"}, "work_item_id": {"type": "string"}, "task_plan_id": {"$ref": "#/$defs/digest"}, "patch_digest": {"$ref": "#/$defs/digest"},
    "changed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "test_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["test_id", "passed", "evidence_digest"], "properties": {"test_id": {"type": "string"}, "passed": {"const": true}, "evidence_digest": {"$ref": "#/$defs/digest"}}}},
    "status": {"const": "pending-verification"}, "rollback_available": {"const": true}, "commit_created": {"const": false}, "push_performed": {"const": false}, "completion_allowed": {"const": false}, "authority_granted": {"const": false}, "result_digest": {"$ref": "#/$defs/digest"}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
