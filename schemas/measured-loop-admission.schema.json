{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:measured-loop-admission:1",
  "title": "KRCN Core adaptive measured loop admission decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "run_id",
    "plan_digest",
    "status_digest",
    "observed_at",
    "decision",
    "requested_claims",
    "active_claims",
    "admitted_claims",
    "concurrency_ceiling",
    "reason_codes",
    "pressure",
    "active_work_action",
    "kill_requested",
    "grants_authority",
    "admission_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/measured-loop-admission.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "status_digest": {
      "$ref": "#/$defs/digest"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "enum": [
        "admit",
        "defer"
      ]
    },
    "requested_claims": {
      "$ref": "#/$defs/positive"
    },
    "active_claims": {
      "$ref": "#/$defs/nonnegative"
    },
    "admitted_claims": {
      "$ref": "#/$defs/nonnegative"
    },
    "concurrency_ceiling": {
      "$ref": "#/$defs/positive"
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "pressure": {
      "$ref": "#/$defs/pressure"
    },
    "active_work_action": {
      "const": "preserve"
    },
    "kill_requested": {
      "const": false
    },
    "grants_authority": {
      "const": false
    },
    "admission_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    },
    "basis-points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "pressure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_basis_points",
        "ram_basis_points",
        "provider_required",
        "provider_quota_remaining_basis_points",
        "cost_headroom_microunits",
        "failure_basis_points"
      ],
      "properties": {
        "cpu_basis_points": {
          "$ref": "#/$defs/basis-points"
        },
        "ram_basis_points": {
          "$ref": "#/$defs/basis-points"
        },
        "provider_required": {
          "type": "boolean"
        },
        "provider_quota_remaining_basis_points": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/basis-points"
            }
          ]
        },
        "cost_headroom_microunits": {
          "$ref": "#/$defs/nonnegative"
        },
        "failure_basis_points": {
          "$ref": "#/$defs/basis-points"
        }
      }
    }
  }
}
