{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:model-health-policy:1",
  "title": "KRCN Core synthetic model health policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "policy_revision",
    "probe_suite_id",
    "probe_suite_revision",
    "prompt_id",
    "expected_response",
    "timeout_seconds",
    "maximum_latency_ms",
    "quarantine_failure_threshold",
    "cooldown_seconds",
    "failure_categories",
    "invariants"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/model-health-policy.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "probe_suite_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "probe_suite_revision": {
      "type": "integer",
      "minimum": 1
    },
    "prompt_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "expected_response": {
      "const": "KRCN_HEALTH_OK"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "maximum_latency_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "quarantine_failure_threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "cooldown_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 604800
    },
    "failure_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "authentication",
          "mismatch",
          "parse",
          "protocol",
          "provider-error",
          "timeout",
          "unavailable"
        ]
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_input_only",
        "project_content_included",
        "credential_values_included",
        "response_content_persisted",
        "health_grants_authority",
        "remote_probe_requires_provider_approval"
      ],
      "properties": {
        "synthetic_input_only": {
          "const": true
        },
        "project_content_included": {
          "const": false
        },
        "credential_values_included": {
          "const": false
        },
        "response_content_persisted": {
          "const": false
        },
        "health_grants_authority": {
          "const": false
        },
        "remote_probe_requires_provider_approval": {
          "const": true
        }
      }
    }
  }
}
