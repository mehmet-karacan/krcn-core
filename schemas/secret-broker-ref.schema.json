{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:secret-broker-ref:1",
  "title": "KRCN Core logical secret broker reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "broker_ref_id",
    "broker_id",
    "secret_ref",
    "operation_scope",
    "expires_at",
    "contains_secret_value",
    "grants_authority",
    "ref_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/secret-broker-ref.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "broker_ref_id": {
      "$ref": "#/$defs/digest"
    },
    "broker_id": {
      "$ref": "#/$defs/id"
    },
    "secret_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-zA-Z0-9][a-zA-Z0-9._/@-]*$"
    },
    "operation_scope": {
      "$ref": "#/$defs/id"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "contains_secret_value": {
      "const": false
    },
    "grants_authority": {
      "const": false
    },
    "ref_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
