{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:information-classes:1",
  "title": "KRCN Core information class registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "classes"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/information-classes.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "classes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "source_of_truth",
          "durability",
          "rebuildable",
          "requires_evidence",
          "requires_approval_to_persist",
          "allowed_record_ownerships"
        ],
        "properties": {
          "id": {
            "enum": [
              "authoritative-source",
              "knowledge",
              "memory",
              "state",
              "history",
              "derived"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_of_truth": {
            "type": "boolean"
          },
          "durability": {
            "enum": [
              "durable",
              "transient",
              "rebuildable"
            ]
          },
          "rebuildable": {
            "type": "boolean"
          },
          "requires_evidence": {
            "type": "boolean"
          },
          "requires_approval_to_persist": {
            "type": "boolean"
          },
          "allowed_record_ownerships": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "runtime",
                "user-data",
                "derived"
              ]
            }
          }
        }
      }
    }
  }
}
