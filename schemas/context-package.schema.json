{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:context-package:1",
  "title": "KRCN Core context package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "task_ref",
    "items",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "project_ref": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "ownership",
          "content"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string"
          },
          "ownership": {
            "enum": [
              "core",
              "runtime",
              "user-data",
              "derived",
              "secrets",
              "unmanaged"
            ]
          },
          "content": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "tokens",
            "characters",
            "bytes"
          ]
        }
      }
    }
  }
}
