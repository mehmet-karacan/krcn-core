{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:phase-4-baseline:1",
  "title": "KRCN Core completed Phase 4 baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_ref", "schema_version", "baseline_id", "phase_id", "status", "completed_steps", "capabilities", "safe_operations", "guarantees", "verification", "next_phase"],
  "properties": {
    "schema_ref": { "const": "schemas/phase-4-baseline.schema.json" },
    "schema_version": { "const": 1 },
    "baseline_id": { "const": "phase-4-context-knowledge-memory" },
    "phase_id": { "const": "phase-4" },
    "status": { "const": "ready" },
    "completed_steps": { "const": 10 },
    "capabilities": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "information-class-contract",
          "revision-aware-provenance",
          "authoritative-knowledge-catalog",
          "deterministic-exact-retrieval",
          "evidence-bound-dependency-retrieval",
          "provider-gated-semantic-retrieval",
          "budgeted-context-packages",
          "approval-gated-memory",
          "transport-neutral-phase-four-services",
          "cross-session-context-reconstruction"
        ]
      }
    },
    "safe_operations": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "knowledge.catalog",
          "knowledge.search-exact",
          "knowledge.search-dependencies",
          "knowledge.search-semantic",
          "context.build",
          "memory.propose",
          "memory.review",
          "memory.persist",
          "memory.lifecycle"
        ]
      }
    },
    "guarantees": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_reference_imported", "local_data_tracked", "implicit_network_access", "literal_secrets_stored", "user_data_preserved", "user_policy_preserved", "source_revision_staleness_visible", "context_budget_enforced", "memory_approval_required", "client_parity", "chat_history_required"],
      "properties": {
        "live_reference_imported": { "const": false },
        "local_data_tracked": { "const": false },
        "implicit_network_access": { "const": false },
        "literal_secrets_stored": { "const": false },
        "user_data_preserved": { "const": true },
        "user_policy_preserved": { "const": true },
        "source_revision_staleness_visible": { "const": true },
        "context_budget_enforced": { "const": true },
        "memory_approval_required": { "const": true },
        "client_parity": { "const": true },
        "chat_history_required": { "const": false }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hermetic_tests", "foundation", "doctor", "offline_install", "cross_session", "stale_source", "context_budget", "policy_preservation", "provider_gate", "client_parity"],
      "properties": {
        "hermetic_tests": { "const": "passed" },
        "foundation": { "const": "passed" },
        "doctor": { "const": "passed" },
        "offline_install": { "const": "passed" },
        "cross_session": { "const": "passed" },
        "stale_source": { "const": "passed" },
        "context_budget": { "const": "passed" },
        "policy_preservation": { "const": "passed" },
        "provider_gate": { "const": "passed" },
        "client_parity": { "const": "passed" }
      }
    },
    "next_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "plan_ref", "implementation_started"],
      "properties": {
        "phase_id": { "const": "phase-5" },
        "plan_ref": { "const": "docs/plans/ROADMAP.md" },
        "implementation_started": { "const": false }
      }
    }
  }
}
