{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krcn.dev/schemas/import-policy.schema.json",
  "title": "KRCN Core import policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "network_required_mode",
    "maximum_text_file_bytes",
    "blocked_globs",
    "content_detectors",
    "required_gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "network_required_mode": {
      "const": "offline"
    },
    "maximum_text_file_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "blocked_globs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "content_detectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_gates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
