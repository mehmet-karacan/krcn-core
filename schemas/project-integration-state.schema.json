{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:project-integration-state:1",
  "title": "KRCN Core complete project integration state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "project_id",
    "scan_sequence",
    "scan_mode",
    "scan_reason",
    "freshness_hours",
    "source_digest",
    "knowledge_digest",
    "embedding_profile_id",
    "role_refs",
    "skill_refs",
    "stages"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/project-integration-state.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "scan_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "scan_mode": {
      "enum": [
        "manual",
        "automatic"
      ]
    },
    "scan_reason": {
      "enum": [
        "explicit-integration-request",
        "explicit-rescan-request",
        "freshness-expired",
        "missing-integration-stage",
        "source-state-missing"
      ]
    },
    "freshness_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8760
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "knowledge_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "embedding_profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "role_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "skill_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration",
        "discovery",
        "knowledge",
        "capability-profile",
        "vector-index",
        "verification"
      ],
      "properties": {
        "registration": {
          "const": "complete"
        },
        "discovery": {
          "const": "complete"
        },
        "knowledge": {
          "const": "complete"
        },
        "capability-profile": {
          "const": "complete"
        },
        "vector-index": {
          "const": "complete"
        },
        "verification": {
          "const": "complete"
        }
      }
    }
  }
}
