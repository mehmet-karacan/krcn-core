{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:task-intent:1",
  "title": "KRCN Core normalized task intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_ref", "schema_version", "task_id", "request_digest", "goal", "scope", "sources", "constraints", "acceptance_criteria", "ownership_impact", "verification_requirements", "assumptions", "ambiguities", "clarification_required", "status", "intent_digest"],
  "properties": {
    "schema_ref": { "const": "schemas/task-intent.schema.json" },
    "schema_version": { "const": 1 },
    "task_id": { "$ref": "#/$defs/id" },
    "request_digest": { "$ref": "#/$defs/sha256" },
    "goal": { "$ref": "#/$defs/value" },
    "scope": { "$ref": "#/$defs/values" },
    "sources": { "$ref": "#/$defs/values" },
    "constraints": { "$ref": "#/$defs/values" },
    "acceptance_criteria": { "$ref": "#/$defs/values" },
    "ownership_impact": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["core", "runtime", "user-data", "derived", "secrets", "unmanaged"] }
    },
    "verification_requirements": { "$ref": "#/$defs/values" },
    "assumptions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assumption_id", "statement", "rationale", "reversible", "impact"],
        "properties": {
          "assumption_id": { "$ref": "#/$defs/id" },
          "statement": { "$ref": "#/$defs/text" },
          "rationale": { "$ref": "#/$defs/text" },
          "reversible": { "const": true },
          "impact": { "const": "minor" }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ambiguity_id", "question", "impact_categories", "blocking"],
        "properties": {
          "ambiguity_id": { "$ref": "#/$defs/id" },
          "question": { "$ref": "#/$defs/text" },
          "impact_categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["scope", "authority", "user-data", "external-system", "irreversible-effect"] }
          },
          "blocking": { "const": true }
        }
      }
    },
    "clarification_required": { "type": "boolean" },
    "status": { "enum": ["ready", "needs-clarification"] },
    "intent_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "origin", "reversible"],
      "properties": {
        "value": { "$ref": "#/$defs/text" },
        "origin": { "enum": ["explicit-user", "safe-assumption"] },
        "reversible": { "type": "boolean" }
      }
    },
    "values": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/value" }
    }
  }
}
