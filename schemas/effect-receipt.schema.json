{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:effect-receipt:1",
  "title": "KRCN terminal effect receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "receipt_id",
    "claim_id",
    "effect_id",
    "effect_digest",
    "idempotency_key",
    "lease",
    "outcome",
    "finished_at",
    "safety",
    "receipt_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/effect-receipt.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "receipt_id": {
      "$ref": "#/$defs/digest"
    },
    "claim_id": {
      "$ref": "#/$defs/digest"
    },
    "effect_id": {
      "$ref": "#/$defs/id"
    },
    "effect_digest": {
      "$ref": "#/$defs/digest"
    },
    "idempotency_key": {
      "$ref": "#/$defs/digest"
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "fencing_token"
      ],
      "properties": {
        "lease_id": {
          "$ref": "#/$defs/id"
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "result_digest",
        "failure_category",
        "failure_digest",
        "retry_safety"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed",
            "denied",
            "timed-out",
            "uncertain"
          ]
        },
        "result_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_category": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry_safety": {
          "enum": [
            "replay-safe",
            "reconciliation-required",
            "non-replayable"
          ]
        }
      }
    },
    "finished_at": {
      "$ref": "#/$defs/time"
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants_authority",
        "terminal_for_claim",
        "contains_raw_payload",
        "contains_physical_paths",
        "contains_credentials"
      ],
      "properties": {
        "grants_authority": {
          "const": false
        },
        "terminal_for_claim": {
          "const": true
        },
        "contains_raw_payload": {
          "const": false
        },
        "contains_physical_paths": {
          "const": false
        },
        "contains_credentials": {
          "const": false
        }
      }
    },
    "receipt_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
