{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:orchestration-timeline:1",
  "title": "KRCN readable orchestration timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_ref", "schema_version", "task_id", "status", "state_revision", "event_head_digest", "events", "timeline_digest", "payload_disclosed"],
  "properties": {
    "schema_ref": {"const": "schemas/orchestration-timeline.schema.json"},
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "status": {"type": "string"},
    "state_revision": {"type": "integer", "minimum": 1},
    "event_head_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "timeline_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload_disclosed": {"const": false}
  }
}
