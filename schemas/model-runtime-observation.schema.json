{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:model-runtime-observation:1",
  "title": "KRCN sanitized model runtime observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "observation_id",
    "project_id",
    "model_ref",
    "inventory_digest",
    "workload",
    "model_assignment_id",
    "trace_digest",
    "observed_at",
    "successful",
    "verifier_passed",
    "latency_ms",
    "input_tokens",
    "output_tokens",
    "actual_cost_microunits",
    "observation_digest",
    "invariants"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/model-runtime-observation.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "observation_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "model_ref": {
      "$ref": "#/$defs/id"
    },
    "inventory_digest": {
      "$ref": "#/$defs/digest"
    },
    "workload": {
      "$ref": "#/$defs/id"
    },
    "model_assignment_id": {
      "$ref": "#/$defs/id"
    },
    "trace_digest": {
      "$ref": "#/$defs/digest"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "successful": {
      "type": "boolean"
    },
    "verifier_passed": {
      "type": "boolean"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    },
    "input_tokens": {
      "$ref": "#/$defs/nonnegative"
    },
    "output_tokens": {
      "$ref": "#/$defs/nonnegative"
    },
    "actual_cost_microunits": {
      "$ref": "#/$defs/nonnegative"
    },
    "observation_digest": {
      "$ref": "#/$defs/digest"
    },
    "invariants": {
      "const": {
        "prompt_content_included": false,
        "response_content_included": false,
        "physical_paths_included": false,
        "grants_authority": false
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    }
  }
}
