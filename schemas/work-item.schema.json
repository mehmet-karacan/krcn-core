{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:work-item:1",
  "title": "KRCN Core authoritative project work item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "work_item_id",
    "project_id",
    "work_type",
    "title",
    "description",
    "status",
    "acceptance_criteria",
    "relations",
    "evidence",
    "provenance",
    "revision",
    "work_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/work-item.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "work_type": {
      "enum": [
        "request",
        "defect",
        "task",
        "subtask",
        "decision"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "blocked",
        "completed",
        "cancelled",
        "archived"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation_type",
          "target_ref"
        ],
        "properties": {
          "relation_type": {
            "enum": [
              "depends-on",
              "blocks",
              "parent-of",
              "implements",
              "caused-by",
              "relates-to",
              "supersedes"
            ]
          },
          "target_ref": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_type",
          "reference",
          "digest",
          "label"
        ],
        "properties": {
          "evidence_type": {
            "enum": [
              "commit",
              "branch",
              "file",
              "test",
              "release",
              "document"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_ref"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "user",
            "import",
            "orchestrator",
            "repository"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "work_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
