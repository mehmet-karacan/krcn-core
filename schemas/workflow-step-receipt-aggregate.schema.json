{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:workflow-step-receipt-aggregate:1",
  "title": "KRCN Core deterministic workflow step receipt aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "correlation_id",
    "receipt_ids",
    "receipt_count",
    "status_counts",
    "usage",
    "aggregation_digest",
    "grants_authority"
  ],
  "properties": {
    "correlation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "receipt_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "receipt_count": {
      "type": "integer",
      "minimum": 1
    },
    "status_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "completed": {
          "$ref": "#/$defs/positive"
        },
        "failed": {
          "$ref": "#/$defs/positive"
        },
        "denied": {
          "$ref": "#/$defs/positive"
        },
        "timed-out": {
          "$ref": "#/$defs/positive"
        },
        "cancelled": {
          "$ref": "#/$defs/positive"
        },
        "recovery-required": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "cost_microunits",
        "currency"
      ],
      "properties": {
        "duration_ms": {
          "$ref": "#/$defs/nonnegative"
        },
        "input_tokens": {
          "$ref": "#/$defs/nonnegative"
        },
        "output_tokens": {
          "$ref": "#/$defs/nonnegative"
        },
        "cache_read_tokens": {
          "$ref": "#/$defs/nonnegative"
        },
        "cache_write_tokens": {
          "$ref": "#/$defs/nonnegative"
        },
        "cost_microunits": {
          "$ref": "#/$defs/nonnegative"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "TRY",
            "USD",
            "EUR",
            null
          ]
        }
      }
    },
    "aggregation_digest": {
      "$ref": "#/$defs/digest"
    },
    "grants_authority": {
      "const": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    }
  }
}
