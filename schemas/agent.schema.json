{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:agent:1",
  "title": "KRCN Core agent definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "agent_id",
    "role",
    "name",
    "description",
    "capabilities",
    "output_contract",
    "may_mutate",
    "status"
  ],
  "properties": {
    "schema_ref": {
      "type": "string"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "role": {
      "enum": [
        "explorer",
        "worker",
        "verifier"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      }
    },
    "tool_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_contract": {
      "type": "string",
      "minLength": 1
    },
    "may_mutate": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "retired"
      ]
    }
  }
}
