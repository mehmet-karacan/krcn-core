{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:engine:1",
  "title": "KRCN Core engine definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "engine_id",
    "version",
    "purpose",
    "responsibilities"
  ],
  "properties": {
    "schema_ref": {
      "type": "string"
    },
    "engine_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_schema": {
      "type": "string",
      "minLength": 1
    }
  }
}
