{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:phase-5-baseline:1",
  "title": "KRCN Core completed Phase 5 baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "baseline_id",
    "phase_id",
    "status",
    "completed_steps",
    "capabilities",
    "safe_operations",
    "guarantees",
    "verification",
    "next_phase"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/phase-5-baseline.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "baseline_id": {
      "const": "phase-5-orchestrator-task-flow"
    },
    "phase_id": {
      "const": "phase-5"
    },
    "status": {
      "const": "ready"
    },
    "completed_steps": {
      "const": 10
    },
    "capabilities": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "typed-natural-language-intent",
          "capability-registry",
          "deterministic-task-planning",
          "exact-plan-authorization",
          "checkpointed-idempotent-workers",
          "evidence-bound-verification",
          "persistent-orchestration-state",
          "deterministic-resume-handoff",
          "transport-neutral-orchestrator-services",
          "cross-client-task-completion"
        ]
      }
    },
    "safe_operations": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "orchestrator.intent",
          "orchestrator.plan",
          "orchestrator.authorize",
          "orchestrator.start",
          "orchestrator.execute",
          "orchestrator.verify",
          "orchestrator.status",
          "orchestrator.resume"
        ]
      }
    },
    "guarantees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_reference_imported",
        "local_data_tracked",
        "implicit_network_access",
        "literal_secrets_stored",
        "user_data_preserved",
        "user_policy_preserved",
        "exact_plan_required",
        "planner_grants_execution",
        "verification_required",
        "idempotent_worker_execution",
        "remote_provider_approval_required",
        "client_parity",
        "chat_history_required"
      ],
      "properties": {
        "live_reference_imported": {
          "const": false
        },
        "local_data_tracked": {
          "const": false
        },
        "implicit_network_access": {
          "const": false
        },
        "literal_secrets_stored": {
          "const": false
        },
        "user_data_preserved": {
          "const": true
        },
        "user_policy_preserved": {
          "const": true
        },
        "exact_plan_required": {
          "const": true
        },
        "planner_grants_execution": {
          "const": false
        },
        "verification_required": {
          "const": true
        },
        "idempotent_worker_execution": {
          "const": true
        },
        "remote_provider_approval_required": {
          "const": true
        },
        "client_parity": {
          "const": true
        },
        "chat_history_required": {
          "const": false
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hermetic_tests",
        "foundation",
        "doctor",
        "offline_install",
        "read_only_task",
        "controlled_core_effect",
        "user_data_approval",
        "policy_preservation",
        "provider_gate",
        "scope_change",
        "interruption_resume",
        "client_parity"
      ],
      "properties": {
        "hermetic_tests": {
          "const": "passed"
        },
        "foundation": {
          "const": "passed"
        },
        "doctor": {
          "const": "passed"
        },
        "offline_install": {
          "const": "passed"
        },
        "read_only_task": {
          "const": "passed"
        },
        "controlled_core_effect": {
          "const": "passed"
        },
        "user_data_approval": {
          "const": "passed"
        },
        "policy_preservation": {
          "const": "passed"
        },
        "provider_gate": {
          "const": "passed"
        },
        "scope_change": {
          "const": "passed"
        },
        "interruption_resume": {
          "const": "passed"
        },
        "client_parity": {
          "const": "passed"
        }
      }
    },
    "next_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "plan_ref",
        "implementation_started",
        "user_approval_required"
      ],
      "properties": {
        "phase_id": {
          "const": "phase-6"
        },
        "plan_ref": {
          "const": "docs/plans/ROADMAP.md"
        },
        "implementation_started": {
          "const": false
        },
        "user_approval_required": {
          "const": true
        }
      }
    }
  }
}
