{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:intent-routing:1",
  "title": "KRCN Core client-neutral intent routes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "first_use",
    "routes"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/intent-routing.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "first_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli_probe",
        "installer_path",
        "installer_plan_argument",
        "install_approval_required",
        "preserve_pending_request",
        "bootstrap_clients_after_home",
        "resume_original_operation"
      ],
      "properties": {
        "cli_probe": {
          "const": "context-validate"
        },
        "installer_path": {
          "const": "tools/install_cli.py"
        },
        "installer_plan_argument": {
          "const": "--plan-only"
        },
        "install_approval_required": {
          "const": true
        },
        "preserve_pending_request": {
          "const": true
        },
        "bootstrap_clients_after_home": {
          "const": true
        },
        "resume_original_operation": {
          "const": true
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "action",
          "application_operation",
          "terms",
          "directory_only",
          "required_inputs",
          "inferred_fields",
          "source_access",
          "copy_source",
          "exact_plan_required",
          "user_data_approval_required",
          "client_specific",
          "supported_clients"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "application_operation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "directory_only": {
            "const": true
          },
          "required_inputs": {
            "const": [
              "local-directory"
            ]
          },
          "inferred_fields": {
            "const": [
              "project-name",
              "project-id",
              "workspace-id",
              "binding-id"
            ]
          },
          "source_access": {
            "const": "read-only"
          },
          "copy_source": {
            "const": false
          },
          "exact_plan_required": {
            "const": true
          },
          "user_data_approval_required": {
            "const": true
          },
          "client_specific": {
            "const": false
          },
          "supported_clients": {
            "type": "array",
            "minItems": 7,
            "uniqueItems": true,
            "items": {
              "enum": [
                "cli",
                "sdk",
                "mcp",
                "plugin",
                "codex",
                "claude",
                "generic-ai"
              ]
            }
          }
        }
      }
    }
  }
}
