{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:capability-registry:1",
  "title": "KRCN Core revision-aware capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_ref", "schema_version", "revision", "records"],
  "properties": {
    "schema_ref": { "const": "schemas/capability-registry.schema.json" },
    "schema_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "records": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "kind", "role", "revision", "capabilities", "side_effects", "read_ownership", "write_ownership", "provider_mode", "approval_triggers", "status", "record_digest"],
        "properties": {
          "record_id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["agent", "skill", "tool", "model"] },
          "role": { "type": ["string", "null"], "enum": ["planner", "worker", "verifier", null] },
          "revision": { "type": "integer", "minimum": 1 },
          "capabilities": { "$ref": "#/$defs/capabilities" },
          "side_effects": { "type": "array", "uniqueItems": true, "items": { "enum": ["read", "write", "execute", "network"] } },
          "read_ownership": { "$ref": "#/$defs/ownership" },
          "write_ownership": { "$ref": "#/$defs/ownership" },
          "provider_mode": { "enum": ["none", "local", "remote"] },
          "approval_triggers": { "type": "array", "uniqueItems": true, "items": { "enum": ["scope-change", "user-data-mutation", "remote-provider-use", "irreversible-effect", "policy-change", "capability-escalation"] } },
          "status": { "enum": ["active", "disabled"] },
          "record_digest": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" } },
    "ownership": { "type": "array", "uniqueItems": true, "items": { "enum": ["core", "runtime", "user-data", "derived", "secrets", "unmanaged"] } }
  }
}
