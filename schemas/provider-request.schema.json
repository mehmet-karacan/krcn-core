{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:provider-request:1",
  "title": "KRCN Core provider request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "provider",
    "endpoint",
    "data_categories",
    "operation_scope",
    "retention_assumptions",
    "session_id",
    "remote"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "endpoint": { "type": "string", "minLength": 1 },
    "data_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "operation_scope": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "retention_assumptions": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "remote": { "type": "boolean" }
  }
}
