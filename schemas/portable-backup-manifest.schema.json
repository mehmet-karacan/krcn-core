{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:portable-backup-manifest:1",
  "title": "KRCN Core portable backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backup_id",
    "layout_version",
    "entries",
    "external_dependencies",
    "exclusions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "backup_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "layout_version": {
      "enum": [
        1,
        2
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "ownership",
          "size",
          "sha256",
          "transformed"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "ownership": {
            "enum": [
              "user-data",
              "runtime",
              "derived"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "transformed": {
            "type": "boolean"
          }
        }
      }
    },
    "external_dependencies": {
      "type": "array"
    },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_values",
        "external_source_content",
        "excluded_secret_count"
      ],
      "properties": {
        "secret_values": {
          "const": true
        },
        "external_source_content": {
          "const": true
        },
        "excluded_secret_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
