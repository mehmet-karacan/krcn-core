{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:model-price-catalog:1",
  "title": "KRCN local dated model price catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "catalog_id",
    "catalog_revision",
    "currency",
    "observed_at",
    "expires_at",
    "entries",
    "catalog_digest",
    "invariants"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/model-price-catalog.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "$ref": "#/$defs/id"
    },
    "catalog_revision": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_ref",
          "input_microunits_per_million",
          "output_microunits_per_million",
          "fixed_microunits"
        ],
        "properties": {
          "model_ref": {
            "$ref": "#/$defs/id"
          },
          "input_microunits_per_million": {
            "$ref": "#/$defs/nonnegative"
          },
          "output_microunits_per_million": {
            "$ref": "#/$defs/nonnegative"
          },
          "fixed_microunits": {
            "$ref": "#/$defs/nonnegative"
          }
        }
      }
    },
    "catalog_digest": {
      "$ref": "#/$defs/digest"
    },
    "invariants": {
      "const": {
        "credentials_included": false,
        "endpoints_included": false,
        "provider_call_performed": false,
        "grants_authority": false
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
