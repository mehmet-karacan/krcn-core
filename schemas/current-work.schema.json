{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:current-work:1",
  "title": "KRCN Core current work pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "phase_id",
    "workstream_id",
    "status",
    "goal",
    "plan_ref",
    "progress_refs",
    "next_actions",
    "approval_gates"
  ],
  "properties": {
    "schema_ref": {
      "$ref": "#/$defs/repoPath"
    },
    "schema_version": {
      "const": 1
    },
    "phase_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "workstream_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "blocked",
        "completed"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "plan_ref": {
      "$ref": "#/$defs/repoPath"
    },
    "progress_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "approval_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked_source_import",
        "user_data_mutation",
        "remote_provider_use"
      ],
      "properties": {
        "tracked_source_import": {
          "type": "boolean"
        },
        "user_data_mutation": {
          "type": "boolean"
        },
        "remote_provider_use": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
