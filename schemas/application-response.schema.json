{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:application-response:1",
  "title": "KRCN Core transport-neutral application response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation", "status", "data"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operation": {
      "enum": [
        "project.list",
        "project.inspect",
        "project.onboard",
        "project.rescan"
      ]
    },
    "status": { "enum": ["ok", "planned", "applied"] },
    "data": { "type": "object", "additionalProperties": true }
  }
}
