{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:application-response:1",
  "title": "KRCN Core transport-neutral application response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation", "status", "data"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operation": {
      "enum": [
        "installation.inspect",
        "installation.verify",
        "release.diff",
        "release.merge",
        "deployment.rollback",
        "project.list",
        "project.inspect",
        "project.learn",
        "project.home.resolve",
        "project.home.initialize",
        "project.onboard",
        "project.rescan",
        "project.rebind",
        "integration.select-read-only",
        "knowledge.catalog",
        "knowledge.search-exact",
        "knowledge.search-dependencies",
        "knowledge.search-semantic",
        "context.build",
        "memory.propose",
        "memory.review",
        "memory.persist",
        "memory.lifecycle",
        "orchestrator.intent",
        "orchestrator.plan",
        "orchestrator.authorize",
        "orchestrator.start",
        "orchestrator.execute",
        "orchestrator.verify",
        "orchestrator.status",
        "orchestrator.resume",
        "portability.backup",
        "portability.restore",
        "portability.migrate-repo-local",
        "portability.migrate-project-home",
        "portability.restore-project-home"
      ]
    },
    "status": { "enum": ["ok", "planned", "applied", "choice-required", "cancelled"] },
    "data": { "type": "object", "additionalProperties": true }
  }
}
