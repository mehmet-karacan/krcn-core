{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:research-runtime-result:1",
  "title": "KRCN Core native research runtime result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "status",
    "research_id",
    "queue_ids",
    "roles",
    "results",
    "native_completion",
    "max_concurrency"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/research-runtime-result.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "completed",
        "already-completed"
      ]
    },
    "research_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "queue_ids": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5,
      "additionalProperties": {
        "type": "string",
        "pattern": "^queue-[a-f0-9]{24}$"
      }
    },
    "roles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "object",
      "maxProperties": 5,
      "additionalProperties": {
        "type": "object"
      }
    },
    "native_completion": {
      "const": true
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  }
}
