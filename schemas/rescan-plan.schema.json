{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:rescan-plan:1",
  "title": "KRCN Core source rescan plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "binding_id",
    "source_id",
    "previous_root_digest",
    "current_root_digest",
    "changes",
    "record_plans"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "previous_root_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "current_root_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "modified",
        "removed",
        "technologies_added",
        "technologies_removed",
        "binding_revision_changed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technologies_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technologies_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "binding_revision_changed": {
          "type": "boolean"
        }
      }
    },
    "record_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_type",
          "record_id",
          "mutation_plan_id",
          "ownership"
        ],
        "properties": {
          "record_type": {
            "enum": [
              "projects",
              "source-states"
            ]
          },
          "record_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "mutation_plan_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ownership": {
            "enum": [
              "user-data",
              "derived"
            ]
          }
        }
      }
    }
  }
}
