{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:provider-assurance-profile:1",
  "title": "KRCN Core provider assurance profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "profile_id",
    "provider_id",
    "observed_at",
    "valid_until",
    "accepted_categories",
    "retention_class",
    "training_opt_out_verified",
    "regional_processing_verified",
    "canary_credential_test_passed",
    "evidence_ref",
    "evidence_digest",
    "contains_payload",
    "grants_authority",
    "profile_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/provider-assurance-profile.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "$ref": "#/$defs/id"
    },
    "provider_id": {
      "$ref": "#/$defs/id"
    },
    "observed_at": {
      "$ref": "#/$defs/time"
    },
    "valid_until": {
      "$ref": "#/$defs/time"
    },
    "accepted_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential-ip"
        ]
      }
    },
    "retention_class": {
      "$ref": "#/$defs/id"
    },
    "training_opt_out_verified": {
      "type": "boolean"
    },
    "regional_processing_verified": {
      "type": "boolean"
    },
    "canary_credential_test_passed": {
      "type": "boolean"
    },
    "evidence_ref": {
      "$ref": "#/$defs/ref"
    },
    "evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "contains_payload": {
      "const": false
    },
    "grants_authority": {
      "const": false
    },
    "profile_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-zA-Z0-9][a-zA-Z0-9._/@-]*$"
    }
  }
}
