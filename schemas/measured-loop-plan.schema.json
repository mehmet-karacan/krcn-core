{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:measured-loop-plan:1",
  "title": "KRCN Core immutable measured loop plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "run_id",
    "project_id",
    "work_item_id",
    "task_id",
    "task_plan_id",
    "task_authorization_id",
    "policy_digest",
    "created_at",
    "objective",
    "metrics",
    "budget",
    "allowed_effects",
    "effect_authorizations",
    "worker_execution_identity",
    "verifier_execution_identity",
    "previous_run",
    "unattended_mode",
    "grants_authority",
    "plan_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/measured-loop-plan.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "task_plan_id": {
      "$ref": "#/$defs/digest"
    },
    "task_authorization_id": {
      "$ref": "#/$defs/digest"
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "objective": {
      "$ref": "#/$defs/objective"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "allowed_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "database",
          "execute",
          "network",
          "plan",
          "read",
          "research",
          "user-data",
          "write"
        ]
      }
    },
    "effect_authorizations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/effect-authorization"
      }
    },
    "worker_execution_identity": {
      "$ref": "urn:krcn:schemas:agent-execution-identity:1"
    },
    "verifier_execution_identity": {
      "$ref": "urn:krcn:schemas:agent-execution-identity:1"
    },
    "previous_run": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/previous-run"
        }
      ]
    },
    "unattended_mode": {
      "const": true
    },
    "grants_authority": {
      "const": false
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_id",
        "statement",
        "constraint_refs",
        "acceptance_refs",
        "objective_digest"
      ],
      "properties": {
        "objective_id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "constraint_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "acceptance_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "objective_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "owner_ref",
        "source_ref",
        "direction",
        "unit",
        "baseline",
        "target",
        "minimum_delta"
      ],
      "properties": {
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "owner_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_ref": {
          "$ref": "#/$defs/ref"
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "baseline": {
          "type": "integer"
        },
        "target": {
          "type": "integer"
        },
        "minimum_delta": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "max_wall_time_seconds",
        "max_input_tokens",
        "max_output_tokens",
        "max_cost_microunits",
        "max_attempts",
        "max_concurrency"
      ],
      "properties": {
        "max_rounds": {
          "$ref": "#/$defs/positive"
        },
        "max_wall_time_seconds": {
          "$ref": "#/$defs/positive"
        },
        "max_input_tokens": {
          "$ref": "#/$defs/positive"
        },
        "max_output_tokens": {
          "$ref": "#/$defs/positive"
        },
        "max_cost_microunits": {
          "$ref": "#/$defs/positive"
        },
        "max_attempts": {
          "$ref": "#/$defs/positive"
        },
        "max_concurrency": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "effect-authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "approval_ref",
        "authorization_digest"
      ],
      "properties": {
        "effect": {
          "enum": [
            "database",
            "execute",
            "network",
            "user-data",
            "write"
          ]
        },
        "approval_ref": {
          "$ref": "#/$defs/ref"
        },
        "authorization_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "previous-run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "state",
        "stop_reason",
        "ended_at",
        "status_digest"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "enum": [
            "cancelled",
            "completed",
            "recovery-required",
            "stopped"
          ]
        },
        "stop_reason": {
          "enum": [
            "accept",
            "budget",
            "cancel",
            "plateau",
            "revert",
            "zombie"
          ]
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "status_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
