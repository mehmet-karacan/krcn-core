{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:measured-loop-status:1",
  "title": "KRCN Core safe measured loop status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "run_id",
    "project_id",
    "work_item_id",
    "plan_digest",
    "state",
    "stop_reason",
    "terminal",
    "resume_allowed",
    "resume_requires_existing_authority",
    "started_at",
    "observed_at",
    "ended_at",
    "latest_iteration_digest",
    "cancellation_digest",
    "verifier_execution_identity_id",
    "usage",
    "budget",
    "metrics",
    "grants_authority",
    "contains_prompts",
    "contains_outputs",
    "contains_physical_paths",
    "contains_secrets",
    "status_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/measured-loop-status.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "work_item_id": {
      "$ref": "#/$defs/id"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "state": {
      "enum": [
        "cancelled",
        "completed",
        "planned",
        "recovery-required",
        "running",
        "stopped"
      ]
    },
    "stop_reason": {
      "enum": [
        "accept",
        "budget",
        "cancel",
        "continue",
        "plateau",
        "revert",
        "zombie"
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "resume_allowed": {
      "type": "boolean"
    },
    "resume_requires_existing_authority": {
      "const": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "latest_iteration_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "cancellation_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "verifier_execution_identity_id": {
      "$ref": "#/$defs/digest"
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "grants_authority": {
      "const": false
    },
    "contains_prompts": {
      "const": false
    },
    "contains_outputs": {
      "const": false
    },
    "contains_physical_paths": {
      "const": false
    },
    "contains_secrets": {
      "const": false
    },
    "status_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rounds",
        "input_tokens",
        "output_tokens",
        "cost_microunits",
        "attempts",
        "peak_concurrency"
      ],
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "peak_concurrency": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "max_wall_time_seconds",
        "max_input_tokens",
        "max_output_tokens",
        "max_cost_microunits",
        "max_attempts",
        "max_concurrency"
      ],
      "properties": {
        "max_rounds": {
          "$ref": "#/$defs/positive"
        },
        "max_wall_time_seconds": {
          "$ref": "#/$defs/positive"
        },
        "max_input_tokens": {
          "$ref": "#/$defs/positive"
        },
        "max_output_tokens": {
          "$ref": "#/$defs/positive"
        },
        "max_cost_microunits": {
          "$ref": "#/$defs/positive"
        },
        "max_attempts": {
          "$ref": "#/$defs/positive"
        },
        "max_concurrency": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "direction",
        "unit",
        "baseline",
        "target",
        "current",
        "target_met"
      ],
      "properties": {
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "baseline": {
          "type": "integer"
        },
        "target": {
          "type": "integer"
        },
        "current": {
          "type": "integer"
        },
        "target_met": {
          "type": "boolean"
        }
      }
    }
  }
}
