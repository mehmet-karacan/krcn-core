{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:integration:1",
  "title": "KRCN Core local integration metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integration_id",
    "adapter_id",
    "source_binding_ref",
    "status",
    "configuration",
    "secret_refs",
    "policy_refs",
    "revision"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "integration_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "adapter_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "source_binding_ref": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "status": { "enum": ["active", "disabled"] },
    "configuration": { "type": "object", "additionalProperties": true },
    "secret_refs": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:secret|keyring|env)://[A-Za-z0-9][A-Za-z0-9._/-]*$"
      }
    },
    "policy_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "revision": { "type": "integer", "minimum": 1 }
  }
}
