{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:phase-9-baseline:1",
  "title": "KRCN Core completed Phase 9 baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "baseline_id",
    "phase_id",
    "status",
    "completed_steps",
    "capabilities",
    "safe_operations",
    "guarantees",
    "verification",
    "maintenance"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/phase-9-baseline.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "baseline_id": {
      "const": "phase-9-continuous-project-integration"
    },
    "phase_id": {
      "const": "phase-9"
    },
    "status": {
      "const": "ready"
    },
    "completed_steps": {
      "const": 8
    },
    "capabilities": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    },
    "safe_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "guarantees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manual_scan_visible",
        "automatic_scan_visible",
        "fresh_complete_no_op",
        "missing_stage_repair",
        "external_source_copied",
        "external_source_mutated",
        "remote_provider_implicit",
        "exact_plan_required",
        "user_policy_preserved",
        "client_parity"
      ],
      "properties": {
        "manual_scan_visible": {
          "const": true
        },
        "automatic_scan_visible": {
          "const": true
        },
        "fresh_complete_no_op": {
          "const": true
        },
        "missing_stage_repair": {
          "const": true
        },
        "external_source_copied": {
          "const": false
        },
        "external_source_mutated": {
          "const": false
        },
        "remote_provider_implicit": {
          "const": false
        },
        "exact_plan_required": {
          "const": true
        },
        "user_policy_preserved": {
          "const": true
        },
        "client_parity": {
          "const": true
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": {
        "const": "passed"
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "freshness_hours"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "freshness_hours": {
          "const": 24
        }
      }
    }
  }
}
