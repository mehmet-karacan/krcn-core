{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:route-shadow-comparison:1",
  "title": "KRCN Core adaptive routing shadow comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "route_decision_id",
    "observed_route",
    "selected_route",
    "comparison_status",
    "reason_codes",
    "behavior_changed",
    "grants_authority",
    "comparison_digest"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/route-shadow-comparison.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "route_decision_id": {
      "$ref": "#/$defs/digest"
    },
    "observed_route": {
      "$ref": "#/$defs/id"
    },
    "selected_route": {
      "$ref": "#/$defs/route"
    },
    "comparison_status": {
      "enum": [
        "matched",
        "mismatch",
        "not-comparable"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "behavior_changed": {
      "const": false
    },
    "grants_authority": {
      "const": false
    },
    "comparison_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "route": {
      "enum": [
        "blocked",
        "coordinator-response",
        "direct-read",
        "parallel-dag",
        "recovery-required",
        "review-only",
        "sequential-dag",
        "single-worker"
      ]
    }
  }
}
