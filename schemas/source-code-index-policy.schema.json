{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:krcn:schemas:source-code-index-policy:1",
  "title": "KRCN Core source code index policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_ref",
    "schema_version",
    "enabled",
    "index_revision",
    "offline_embedding_profile_id",
    "vector_dimensions",
    "chunk_target_lines",
    "chunk_overlap_lines",
    "maximum_chunk_characters",
    "maximum_indexed_file_bytes",
    "maximum_chunks",
    "maximum_search_content_characters",
    "supported_extensions",
    "supported_filenames",
    "source_content_persisted",
    "remote_provider_implicit"
  ],
  "properties": {
    "schema_ref": {
      "const": "schemas/source-code-index-policy.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "enabled": {
      "const": true
    },
    "index_revision": {
      "const": 1
    },
    "offline_embedding_profile_id": {
      "const": "deterministic-hashing"
    },
    "vector_dimensions": {
      "const": 192
    },
    "chunk_target_lines": {
      "type": "integer",
      "minimum": 20,
      "maximum": 1000
    },
    "chunk_overlap_lines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "maximum_chunk_characters": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 100000
    },
    "maximum_indexed_file_bytes": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000000
    },
    "maximum_chunks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "maximum_search_content_characters": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 1000000
    },
    "supported_extensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.[a-z0-9]+$"
      }
    },
    "supported_filenames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "source_content_persisted": {
      "const": false
    },
    "remote_provider_implicit": {
      "const": false
    }
  }
}
