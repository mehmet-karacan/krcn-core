{
  "schema_ref": "schemas/oracle-metadata-policy.schema.json",
  "schema_version": 1,
  "policy_revision": 1,
  "default_collection_mode": "select-compatible",
  "allowed_object_types": [
    "CLUSTER",
    "CONSTRAINT",
    "DATABASE_LINK",
    "FUNCTION",
    "GRANT",
    "INDEX",
    "MATERIALIZED_VIEW",
    "MATERIALIZED_VIEW_LOG",
    "PACKAGE_BODY",
    "PACKAGE_SPEC",
    "PROCEDURE",
    "SEQUENCE",
    "SYNONYM",
    "TABLE",
    "TRIGGER",
    "TYPE_BODY",
    "TYPE_SPEC",
    "VIEW"
  ],
  "allowed_inventory_views": [
    "ALL_ARGUMENTS",
    "ALL_COL_COMMENTS",
    "ALL_CONSTRAINTS",
    "ALL_CONS_COLUMNS",
    "ALL_DEPENDENCIES",
    "ALL_ERRORS",
    "ALL_IDENTIFIERS",
    "ALL_INDEXES",
    "ALL_IND_COLUMNS",
    "ALL_OBJECTS",
    "ALL_TAB_COLUMNS",
    "ALL_TAB_COMMENTS"
  ],
  "allowed_metadata_functions": [
    "GET_DDL",
    "GET_DEPENDENT_DDL",
    "GET_GRANTED_DDL"
  ],
  "batch_open_requires_explicit_execute": true,
  "free_sql_allowed": false,
  "row_data_allowed": false,
  "raw_database_link_ddl_persisted": false,
  "partial_snapshot_retires_missing_objects": false,
  "offline_embedding_profile_id": "deterministic-hashing",
  "vector_dimensions": 192,
  "maximum_object_bytes": 4000000,
  "maximum_chunks": 250000
}
