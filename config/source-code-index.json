{
  "schema_ref": "schemas/source-code-index-policy.schema.json",
  "schema_version": 1,
  "enabled": true,
  "index_revision": 1,
  "offline_embedding_profile_id": "deterministic-hashing",
  "vector_dimensions": 192,
  "chunk_target_lines": 120,
  "chunk_overlap_lines": 20,
  "maximum_chunk_characters": 16000,
  "maximum_indexed_file_bytes": 2000000,
  "maximum_chunks": 100000,
  "maximum_search_content_characters": 40000,
  "supported_extensions": [
    ".cs",
    ".css",
    ".go",
    ".gradle",
    ".graphql",
    ".groovy",
    ".h",
    ".html",
    ".java",
    ".jrxml",
    ".js",
    ".json",
    ".jsx",
    ".kt",
    ".kts",
    ".md",
    ".php",
    ".properties",
    ".py",
    ".rb",
    ".rs",
    ".scss",
    ".sh",
    ".sql",
    ".swift",
    ".toml",
    ".ts",
    ".tsx",
    ".vue",
    ".xml",
    ".yaml",
    ".yml"
  ],
  "supported_filenames": [
    "dockerfile",
    "makefile"
  ],
  "source_content_persisted": false,
  "remote_provider_implicit": false
}
