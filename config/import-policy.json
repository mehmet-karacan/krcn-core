{
  "schema_version": 1,
  "network_required_mode": "offline",
  "maximum_text_file_bytes": 2000000,
  "blocked_globs": [
    "**/.git/**",
    "**/.krcn/**",
    "**/.idea/**",
    "**/.run/**",
    "**/.vscode/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/_next/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/outputs/**",
    "**/generated/**",
    "**/vendor/**",
    "**/ai_yedek/**",
    "**/sqlcl/**",
    "**/deploy_log/**",
    "**/frontend/tools/node-*/**",
    "**/coverage/lcov-report/**",
    "**/coverage/tmp/**",
    "**/coverage/*.html",
    "**/coverage/*.json",
    "**/coverage/*.lcov",
    "**/coverage/*.xml",
    "**/.coverage",
    "**/.coverage.*",
    "**/coverage.xml",
    "**/htmlcov/**",
    "**/lcov.info",
    "**/logs/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/*.pyc",
    "**/*.pyo",
    "**/*.jar",
    "**/*.war",
    "**/*.ear",
    "**/*.zip",
    "**/*.dmp",
    "**/*.dump",
    "**/*.log",
    "**/*.db",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.pem",
    "**/*.key",
    "**/.env",
    "**/.env.*"
  ],
  "content_detectors": [
    "windows-absolute-path",
    "posix-user-path",
    "private-key",
    "github-token",
    "aws-access-key",
    "generic-secret-assignment",
    "credential-uri",
    "email-address",
    "ip-address",
    "unicode-long-dash"
  ],
  "required_gates": [
    "ownership-classified",
    "secret-scan-clean",
    "portability-scan-clean",
    "network-disabled",
    "synthetic-fixtures-only",
    "hermetic-tests-pass",
    "staged-diff-reviewed",
    "user-approved"
  ]
}
