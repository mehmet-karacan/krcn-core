{
  "schema_version": 1,
  "default_unmatched": {
    "ownership": "unmanaged",
    "merge_strategy": "preserve",
    "approval_required": true
  },
  "classes": [
    {
      "id": "core",
      "description": "Versioned product code and managed defaults",
      "merge_strategy": "replace-managed",
      "paths": [
        ".ai/**",
        "AGENTS.md",
        "AI-CONTEXT.md",
        "CLAUDE.md",
        "README.md",
        "pyproject.toml",
        "src/**",
        "config/**",
        "docs/**",
        "schemas/**",
        "templates/**",
        "tests/**",
        "tools/**"
      ]
    },
    {
      "id": "runtime",
      "description": "Local execution state, events, locks, and checkpoints",
      "merge_strategy": "preserve",
      "paths": [
        ".krcn/runtime/**",
        ".krcn/events/**",
        ".krcn/locks/**",
        ".krcn/checkpoints/**",
        ".krcn/projects/*/runtime/**",
        ".krcn/global/runtime/**"
      ]
    },
    {
      "id": "user-data",
      "description": "User-owned projects, documents, work items, decisions, and memory",
      "merge_strategy": "preserve",
      "paths": [
        ".krcn/workspaces/**",
        ".krcn/projects/*.json",
        ".krcn/projects/integration-states/**",
        ".krcn/projects/capsules/**",
        ".krcn/projects/*/manifest.json",
        ".krcn/projects/*/project.json",
        ".krcn/projects/*/workspaces/**",
        ".krcn/projects/*/bindings/**",
        ".krcn/projects/*/integration/**",
        ".krcn/projects/*/knowledge/**",
        ".krcn/projects/*/memory/**",
        ".krcn/projects/*/policies/**",
        ".krcn/projects/*/work/**",
        ".krcn/projects/*/database/**",
        ".krcn/projects/*/local-data/**",
        ".krcn/integrations/**",
        ".krcn/documents/**",
        ".krcn/work-items/**",
        ".krcn/decisions/**",
        ".krcn/knowledge/**",
        ".krcn/memory/**",
        ".krcn/models/**",
        ".krcn/policies/**",
        ".krcn/source-bindings/**",
        ".krcn/project-home.json",
        ".krcn/layout.json",
        ".krcn/local-data/**",
        ".krcn/local/**",
        ".krcn/global/project-capsules/**",
        ".krcn/global/projects/**",
        ".krcn/global/workspaces/**",
        ".krcn/global/bindings/**",
        ".krcn/global/integration/**",
        ".krcn/global/knowledge/**",
        ".krcn/global/memory/**",
        ".krcn/global/policies/**",
        ".krcn/global/work/**",
        ".krcn/global/database/**",
        ".krcn/global/local-data/**",
        ".krcn/global/models/**"
      ]
    },
    {
      "id": "derived",
      "description": "Rebuildable indexes, embeddings, summaries, and caches",
      "merge_strategy": "migrate-or-rebuild",
      "paths": [
        ".krcn/derived/**",
        ".krcn/indexes/**",
        ".krcn/cache/**",
        ".krcn/projects/*/derived/**",
        ".krcn/global/derived/**"
      ]
    },
    {
      "id": "secrets",
      "description": "Local credentials and secret references",
      "merge_strategy": "preserve",
      "paths": [
        ".krcn/secrets/**",
        ".krcn/projects/*/secrets/**",
        ".krcn/global/secrets/**",
        ".env",
        ".env.*"
      ]
    },
    {
      "id": "unmanaged",
      "description": "Files not owned by a KRCN Core release",
      "merge_strategy": "preserve",
      "paths": []
    }
  ]
}
